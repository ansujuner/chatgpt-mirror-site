{
  "name": "chatgpt-ui-replica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:lan": "node tools/dev.mjs --lan",
    "dev:web": "vite",
    "bridge": "python -m server",
    "test:dev-config": "node --test tools/dev-config.test.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
    "lint": "oxlint src",
    "test:auth": "node --experimental-strip-types --test qa/auth-state.test.ts qa/auth-flow.test.ts qa/session-login.test.ts",
    "test:usage": "node --experimental-strip-types --test qa/codex-usage-details.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
