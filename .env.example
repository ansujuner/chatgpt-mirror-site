# 默认无需配置：前端通过 Vite 代理请求本地 account bridge。
# VITE_CHAT_API_URL=/api/chat/completions
# VITE_CHAT_MODEL=chatgpt-guest

# 如需不访问上游、只测试界面，启用本地模拟回复：
# VITE_CHAT_API_MODE=mock

# 仅当改接你自己的 OpenAI-compatible SSE 服务时使用：
# VITE_CHAT_API_URL=http://127.0.0.1:3000/v1/chat/completions
# VITE_CHAT_MODEL=your-model-name

# VITE_* 会进入浏览器代码，不要填写长期私钥。
# VITE_CHAT_API_TOKEN=

# 公网容器应隐藏仅支持本机 loopback 回调的第三方 OAuth 入口，并使用 Session 登录。
# VITE_HOSTED_SESSION_ONLY=true

# Development listener. `npm run dev:lan` sets the web host to 0.0.0.0 while
# leaving the account bridge on loopback. These values are optional overrides.
# CHATGPT_DEV_LAN=false
# CHATGPT_WEB_HOST=127.0.0.1
# CHATGPT_WEB_PORT=5173
# CHATGPT_DEV_RELOAD=false
# Override only when Vite proxies to a bridge on another machine/container.
# CHATGPT_BRIDGE_PROXY_TARGET=http://127.0.0.1:8787

# Bridge deployment boundary. Keep 127.0.0.1 when Vite/reverse proxy owns the
# public listener; use 0.0.0.0 only when the API itself must accept LAN traffic.
# CHATGPT_BRIDGE_HOST=127.0.0.1
# CHATGPT_BRIDGE_PORT=8787
# External API origin as seen by the browser when a reverse proxy rewrites Host.
# CHATGPT_BRIDGE_PUBLIC_ORIGIN=https://chat.example.com
# Exact credentialed cross-origin frontends, comma-separated; never use '*'.
# CHATGPT_BRIDGE_ALLOWED_ORIGINS=https://chat.example.com
# Optional raw Host allowlist for public deployment, comma-separated.
# CHATGPT_BRIDGE_ALLOWED_HOSTS=chat.example.com,127.0.0.1
# Immediate reverse proxies trusted for X-Forwarded-For/Proto. Do not use '*'
# on an Internet-facing listener.
# CHATGPT_BRIDGE_TRUSTED_PROXY_IPS=127.0.0.1

# Session login stays in server memory only. Values are seconds.
# Provider login uses official browser OAuth/PKCE and a loopback callback at
# http://localhost:1455/auth/callback. Keep port 1455 free while signing in.
# The default OAuth client id is a public native-app identifier, not a secret.
# CHATGPT_OAUTH_ISSUER=https://auth.openai.com
# CHATGPT_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# Popup completion defaults to localhost:5173 when a browser Origin is absent.
# CHATGPT_OAUTH_APP_ORIGIN=http://localhost:5173
# CHATGPT_AUTH_SESSION_TTL=43200
# CHATGPT_AUTH_SESSION_IDLE_TTL=10800
# CHATGPT_AUTH_SESSION_MAX_ENTRIES=32
# CHATGPT_AUTH_UPSTREAM_TIMEOUT=25
# Idempotent account/session validation reads retry transient network/TLS errors.
# CHATGPT_AUTH_UPSTREAM_NETWORK_ATTEMPTS=3
# Per-account live WHAM cache. Set 0 to disable; never shared between sessions.
# CHATGPT_CODEX_USAGE_CACHE_TTL=30
# CHATGPT_AUTH_MAX_CONCURRENCY=2
# CHATGPT_AUTH_CONVERSATION_TTL=1800
# CHATGPT_AUTH_MAX_CONVERSATIONS=64
# CHATGPT_AUTH_BOOTSTRAP_TIMEOUT=20
# CHATGPT_AUTH_SENTINEL_TIMEOUT=25
# CHATGPT_AUTH_PREPARE_TIMEOUT=30
# CHATGPT_AUTH_CONVERSATION_TIMEOUT=180
# CHATGPT_AUTH_CHAT_MAX_ATTEMPTS=2
# CHATGPT_AUTH_MAX_STREAM_BYTES=16777216
# Authenticated history list/detail, pagination, and opaque binding limits.
# CHATGPT_AUTH_HISTORY_TIMEOUT=25
# CHATGPT_AUTH_HISTORY_PAGE_TURNS=100
# CHATGPT_AUTH_HISTORY_MAX_PAGES=64
# CHATGPT_AUTH_HISTORY_MAX_MESSAGES=10000
# CHATGPT_AUTH_HISTORY_MAX_RESPONSE_BYTES=16777216
# CHATGPT_AUTH_HISTORY_BINDING_TTL=10800
# CHATGPT_AUTH_HISTORY_MAX_BINDINGS=4096
# CHATGPT_AUTH_HISTORY_MAX_CURSORS=1024
# Browser attachment boundary (decoded bytes): 10 files, 25 MiB each, 50 MiB total.
# CHATGPT_AUTH_ATTACHMENT_MAX_FILES=10
# CHATGPT_AUTH_ATTACHMENT_MAX_FILE_BYTES=26214400
# CHATGPT_AUTH_ATTACHMENT_MAX_TOTAL_BYTES=52428800
# Base64 JSON request ceiling; keep this above 4/3 of the total decoded limit.
# CHATGPT_CHAT_MAX_REQUEST_BYTES=72089600
# Authenticated upstream file protocol limits and timeouts.
# CHATGPT_AUTH_FILE_CREATE_TIMEOUT=60
# CHATGPT_AUTH_FILE_BLOB_TIMEOUT=300
# CHATGPT_AUTH_FILE_PROCESS_TIMEOUT=300
# CHATGPT_AUTH_FILE_MAX_BYTES=536870912
# CHATGPT_AUTH_FILE_PROCESS_MAX_BYTES=4194304
# CHATGPT_AUTH_FILE_ENTRY_SURFACE=chat_composer
# CHATGPT_AUTH_TIMEZONE=Asia/Shanghai
# CHATGPT_AUTH_TIMEZONE_OFFSET_MIN=-480
# Sandbox-local TLS may use a private certificate. Use true for public PKI.
# CHATGPT_AUTH_VERIFY_TLS=false

# auto = Secure on HTTPS/public hosts; disabled on loopback/private-LAN HTTP.
# CHATGPT_AUTH_COOKIE_SECURE=auto
# strict is best for a same-origin deployment. Use none only for an explicitly
# allowlisted cross-site HTTPS frontend; None always forces Secure.
# CHATGPT_AUTH_COOKIE_SAMESITE=strict

# Guest Web-Mobile bootstrap fingerprint. Keep impersonation and UA aligned.
# CHATGPT_BRIDGE_BROWSER_IMPERSONATE=chrome142
# CHATGPT_BRIDGE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36
# Sandbox-local TLS may use a private certificate. Use true for public PKI.
# CHATGPT_BRIDGE_VERIFY_TLS=false
